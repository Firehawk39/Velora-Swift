# Velora AI Engine Environment Configuration

# (Required) Base URL for your Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# (Optional) Model to use for chat and reasoning
VELORA_MODEL=gemma2:9b

# (Optional) Path to your music library for ingestion
MUSIC_DIR=/music

# (Optional) API Key to secure your backend (If implemented)
# API_KEY=your_secure_api_key
